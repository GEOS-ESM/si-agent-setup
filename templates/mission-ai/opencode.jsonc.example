{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "policies": [
    { "action": "provider.use", "resource": "opencode", "effect": "deny" },
    { "action": "provider.use", "resource": "azure", "effect": "deny" },
    { "action": "provider.use", "resource": "amazon-bedrock", "effect": "deny" }
  ],
  "providers": {
    "nasa_mission_ai": {
      "name": "NASA Mission AI LiteLLM",
      "env": ["NASA_MISSION_AI_API_KEY"],
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://proxy.fast.luna.nasa.gov"
      },
      "models": {
        // Explicit limits matter: without them V2 assumes 200k context / 32k output
        // for models outside its catalog, which makes compaction trigger far too early.
        "claude-opus-5-5": { "name": "Claude Opus 5.5 (Powerful / Higher cost)", "compatibility": { "cacheFormat": "anthropic" }, "limit": { "context": 1000000, "output": 128000 } },
        "claude-sonnet-5-5": { "name": "Claude Sonnet 5.5 (Versatile / Moderate cost)", "compatibility": { "cacheFormat": "anthropic" }, "limit": { "context": 1000000, "output": 128000 } },
        "claude-haiku-5-5": { "name": "Claude Haiku 5.5 (Lightweight / Lower cost)", "compatibility": { "cacheFormat": "anthropic" }, "limit": { "context": 1000000, "output": 128000 } },
        "gemini-4-argon": { "name": "Gemini 4 Argon (Powerful / Moderate cost)" },
        "gemini-3.8-flash": { "name": "Gemini 3.8 Flash (Versatile / Lower cost)", "limit": { "context": 1048576, "output": 65536 } }
      }
    },
    // OpenAI models use the native OpenAI provider package; the openai-compatible
    // package above has issues with them on Mission AI.
    "nasa_mission_ai_openai": {
      "name": "NASA Mission AI LiteLLM (OpenAI)",
      "env": ["NASA_MISSION_AI_API_KEY"],
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://proxy.fast.luna.nasa.gov"
      },
      "models": {
        "gpt-6-astra": { "name": "GPT-6 Astra (Powerful / Higher cost)", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-6-sol": { "name": "GPT-6 Sol (Powerful / Moderate cost)", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-6-luna": { "name": "GPT-6 Luna (Lightweight / Lower cost)", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-6.1-sol": { "name": "GPT-6.1 Sol (Powerful / Moderate cost)", "limit": { "context": 1131072, "output": 131072 } },
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol (Powerful / Higher cost)", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra (Versatile / Moderate cost)", "limit": { "context": 1050000, "output": 128000 } },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna (Lightweight / Lower cost)", "limit": { "context": 1050000, "output": 128000 } }
      }
    }
  }
}
